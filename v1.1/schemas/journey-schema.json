{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.digitalservice.design/journey/v1.1",
  "title": "Customer Journey Schema",
  "description": "Schema for customer journeys in service design, integrating with Core Personas and Role Cards. Per Service Design Journey Standard v1.1",
  "type": "object",
  "properties": {
    "schema_info": {
      "type": "object",
      "properties": {
        "version": {"type": "string", "pattern": "^1\\.1\\.[0-9]+$"},
        "standard": {
          "type": "string",
          "const": "Service Design Journey Standard v1.1"
        },
        "schema_type": {
          "type": "string",
          "const": "journey",
          "description": "Type of schema artifact"
        },
        "namespace": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "created_date": {"type": "string", "format": "date-time"},
        "last_updated": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string"},
        "organization": {"type": "string"}
      },
      "required": ["version", "standard", "last_updated"],
      "additionalProperties": false
    },
    "lanes": {
      "type": "object",
      "properties": {
        "standard": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "label": {"type": "string", "maxLength": 100},
              "type": {"enum": ["text", "list", "metric", "emotion", "reference", "barrier", "channel"]},
              "description": {"type": "string", "maxLength": 500},
              "cardinality": {"enum": ["one-per-step", "many-per-step"]},
              "visible": {"type": "boolean", "default": true}
            },
            "required": ["id", "label", "type"],
            "additionalProperties": false
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "label": {"type": "string", "maxLength": 100},
              "type": {"enum": ["text", "list", "metric", "emotion", "reference", "barrier", "channel"]},
              "description": {"type": "string", "maxLength": 500}
            },
            "required": ["id", "label", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": ["standard"],
      "additionalProperties": false
    },
    "journey": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "title": {"type": "string", "maxLength": 200},
        "purpose": {"type": "string", "maxLength": 1000},
        "summary": {"type": "string", "maxLength": 1000},
        "context": {
          "type": "object",
          "description": "Journey context including persona and role references",
          "properties": {
            "personaRef": {
              "type": "string",
              "pattern": "^persona-[a-z0-9_-]+$",
              "description": "Reference to a Core Persona ID (v1.1 compositional approach)"
            },
            "roleRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^role-[a-z0-9_-]+$"
              },
              "description": "References to one or more Role Card IDs (v1.1 compositional approach)"
            },
            "pairingRef": {
              "type": "string",
              "pattern": "^pairing-[a-z0-9_-]+$",
              "description": "Optional reference to a pre-defined Pairing ID"
            },
            "persona_id": {
              "type": "string",
              "description": "DEPRECATED: Legacy persona ID reference for backward compatibility with v1.0.x"
            },
            "persona_context": {"type": "string", "maxLength": 1000},
            "use_case": {"type": "string", "maxLength": 500},
            "scope": {"type": "string", "maxLength": 500},
            "as_is": {"type": "boolean", "default": true},
            "timeframe": {"type": "string", "maxLength": 200},
            "success_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric": {"type": "string", "maxLength": 200},
                  "target": {"type": "string", "maxLength": 100}
                },
                "required": ["metric"],
                "additionalProperties": false
              }
            }
          },
          "required": ["persona_context"],
          "additionalProperties": false
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
              "name": {"type": "string", "maxLength": 100},
              "goal": {"type": "string", "maxLength": 500},
              "moments_that_matter": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step_id": {"type": "string"},
                    "moment": {"type": "string", "maxLength": 500},
                    "importance": {"enum": ["critical", "high", "medium", "low"]},
                    "emotional_intensity": {"type": "integer", "minimum": -2, "maximum": 2}
                  },
                  "required": ["step_id", "moment"],
                  "additionalProperties": false
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
                    "name": {"type": "string", "maxLength": 100},
                    "duration_ms": {"type": "integer", "minimum": 0},
                    "lane_content": {
                      "type": "object",
                      "properties": {
                        "barriers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {"enum": ["process", "technology", "knowledge", "resource", "policy", "cultural", "vision", "communications", "governance"]},
                              "description": {"type": "string", "maxLength": 500},
                              "severity": {"type": "integer", "minimum": 1, "maximum": 5},
                              "workarounds": {"type": "string", "maxLength": 500},
                              "emergesFrom": {
                                "type": "string",
                                "maxLength": 200,
                                "description": "How this barrier emerges from the persona-role interaction (v1.1)"
                              }
                            },
                            "required": ["type", "description"],
                            "additionalProperties": false
                          }
                        },
                        "channels": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "description": "Channel type. Suggested: website, app, email, chat, social_media, messaging_app, push_notification (digital); phone, sms, video_call (telecom); in_person, post, print (physical). Custom types allowed."
                              },
                              "serviceModel": {
                                "enum": ["self_service", "managed", "both"],
                                "description": "Who controls the interaction: self_service (user-driven), managed (staff-driven), or both"
                              },
                              "category": {
                                "enum": ["digital", "telecom", "physical"],
                                "description": "High-level grouping for ownership and cost analysis. Digital: apps, websites, online platforms. Telecom: phone calls, SMS. Physical: locations, staff, tangible materials."
                              },
                              "interaction": {
                                "enum": ["human", "automated"],
                                "description": "Whether a human responds or it's automated"
                              },
                              "name": {
                                "type": "string",
                                "maxLength": 100,
                                "description": "Specific instance name (e.g., 'StyleMart App', 'Customer Service Line')"
                              },
                              "usage_context": {
                                "type": "string",
                                "maxLength": 200,
                                "description": "When and why this channel is used at this step"
                              },
                              "ownership": {
                                "enum": ["own", "third_party", "partner"],
                                "description": "Who owns/operates this channel"
                              },
                              "custom_type": {
                                "type": "string",
                                "maxLength": 50,
                                "description": "Custom type description when using non-standard channel types"
                              }
                            },
                            "required": ["type", "serviceModel"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": ["id", "name"],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": ["id", "name", "steps"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "validation": {
          "type": "object",
          "properties": {
            "research_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {"type": "string", "maxLength": 200},
                  "type": {"enum": ["interview", "survey", "analytics", "observation", "existing_research"]},
                  "date": {"type": "string", "format": "date"},
                  "confidence": {"enum": ["high", "medium", "low"]}
                },
                "required": ["source", "type"],
                "additionalProperties": false
              }
            },
            "confidence_level": {"enum": ["high", "medium", "low"]}
          },
          "required": ["research_sources", "confidence_level"],
          "additionalProperties": false
        }
      },
      "required": ["id", "title", "purpose", "summary", "context", "phases", "validation"],
      "additionalProperties": false
    }
  },
  "required": ["schema_info", "lanes", "journey"],
  "additionalProperties": false
}
