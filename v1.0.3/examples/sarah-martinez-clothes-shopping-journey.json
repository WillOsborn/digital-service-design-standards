  "journey": {
    "id": "sarah-martinez-clothes-shopping-journey",
    "title": "Online Clothes Shopping Journey - Personal Treat Purchase",
    "purpose": "To understand the end-to-end experience of a busy working mom discovering, purchasing, receiving, and returning clothing bought online through a promotional offer",
    "summary": "Sarah receives a promotional notification from her regular shopping app about a flash sale, browses for a personal treat she wouldn't normally buy at full price, completes a purchase, receives delivery, tries on the item, and ultimately returns it due to fit issues. The journey captures the emotional highs and lows of convenient mobile shopping balanced against the uncertainty of online clothing purchases.",
    "context": {
      "persona_id": "sarah-martinez-working-mom-consumer",
      "persona_context": "Sarah is a 32-year-old working mom in Austin who values convenience and quality. She's a smartphone-first user who prefers mobile shopping apps for quick purchases. She's price-conscious but will treat herself when good deals arise. Her limited time means she relies heavily on apps and has concerns about online clothing quality and fit.",
      "use_case": "Promotional-triggered impulse purchase of personal clothing item",
      "scope": "From initial notification through to completed return",
      "as_is": true,
      "timeframe": "Approximately 7-10 days from notification to return completion",
      "success_criteria": [
        {
          "metric": "Time to complete purchase",
          "target": "Under 5 minutes from opening app"
        },
        {
          "metric": "Return process completion time",
          "target": "Under 10 minutes to initiate"
        },
        {
          "metric": "Refund processing time",
          "target": "Within 5 business days"
        }
      ]
    },
    "phases": [
      {
        "id": "discovery",
        "name": "Discovery",
        "goal": "Become aware of a compelling offer and decide to explore further",
        "moments_that_matter": [
          {
            "step_id": "receive-notification",
            "moment": "The notification arrives at a moment when Sarah can actually engage with it",
            "importance": "high",
            "emotional_intensity": 1
          }
        ],
        "steps": [
          {
            "id": "receive-notification",
            "name": "Receive promotional notification",
            "duration_ms": 5000,
            "lane_content": {
              "actions": [
                "Phone buzzes with notification",
                "Glances at lock screen",
                "Reads notification preview"
              ],
              "thoughts": "Oh, StyleMart has a flash sale... 40% off? That's actually good. Maybe I could get that cardigan I've been eyeing.",
              "emotions": {
                "state": "intrigued",
                "intensity": 1
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Push notification on mobile device"
                }
              ],
              "barriers": [],
              "opportunities": [
                "Personalize notification based on browsing history",
                "Include specific product recommendations in notification"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, around 12:30pm"
            }
          },
          {
            "id": "open-app",
            "name": "Open app to explore sale",
            "duration_ms": 15000,
            "lane_content": {
              "actions": [
                "Taps notification to open app",
                "Waits for app to load",
                "Views sale landing page"
              ],
              "thoughts": "Let me just have a quick look while I have a few minutes. The sale ends tonight so I need to decide soon.",
              "emotions": {
                "state": "curious",
                "intensity": 1
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Browsing sale landing page"
                }
              ],
              "barriers": [
                {
                  "type": "technology",
                  "description": "App takes 8 seconds to fully load sale page",
                  "severity": 2,
                  "workarounds": "Waits patiently as it's within acceptable range"
                }
              ],
              "opportunities": [
                "Pre-cache sale content before notification send",
                "Show countdown timer to create appropriate urgency"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, around 12:30pm"
            }
          }
        ]
      },
      {
        "id": "browsing",
        "name": "Browsing & Selection",
        "goal": "Find a desirable item that feels like a worthwhile treat within budget",
        "moments_that_matter": [
          {
            "step_id": "find-item",
            "moment": "Finding an item that feels special enough to be a treat but practical enough to justify",
            "importance": "critical",
            "emotional_intensity": 2
          },
          {
            "step_id": "check-reviews",
            "moment": "Reading reviews that either build or undermine confidence in the purchase",
            "importance": "high",
            "emotional_intensity": 0
          }
        ],
        "steps": [
          {
            "id": "browse-categories",
            "name": "Browse sale categories",
            "duration_ms": 120000,
            "lane_content": {
              "actions": [
                "Scrolls through sale categories",
                "Taps into 'Women's Clothing'",
                "Filters by size and price range",
                "Scrolls through product grid"
              ],
              "thoughts": "There's so much here. Let me filter this down. I don't need another basic t-shirt... I want something a bit special that I wouldn't normally buy.",
              "emotions": {
                "state": "slightly overwhelmed but engaged",
                "intensity": 0
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Category browsing and filtering"
                }
              ],
              "barriers": [
                {
                  "type": "knowledge",
                  "description": "Difficult to assess fabric quality from photos alone",
                  "severity": 3,
                  "workarounds": "Relies on zooming in on product images"
                },
                {
                  "type": "process",
                  "description": "Filter options reset when navigating back from product detail",
                  "severity": 2,
                  "workarounds": "Tries to remember filter settings"
                }
              ],
              "opportunities": [
                "Persist filter selections throughout session",
                "Add 'treat yourself' or 'special occasion' filter category",
                "Show fabric detail close-ups automatically"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, 12:32pm"
            }
          },
          {
            "id": "find-item",
            "name": "Find appealing item",
            "duration_ms": 60000,
            "lane_content": {
              "actions": [
                "Spots a wrap dress in a color she loves",
                "Taps to view product details",
                "Swipes through all product images",
                "Checks original price vs sale price"
              ],
              "thoughts": "Oh this is lovely! That emerald green would be perfect for date nights. £85 down to £51... that's actually reasonable for a treat. I'd never pay full price but this feels justified.",
              "emotions": {
                "state": "excited",
                "intensity": 2
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Product detail page"
                }
              ],
              "barriers": [],
              "opportunities": [
                "Show 'you saved £X' prominently to reinforce value",
                "Suggest styling options or accessories"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, 12:35pm"
            }
          },
          {
            "id": "check-sizing",
            "name": "Check sizing information",
            "duration_ms": 90000,
            "lane_content": {
              "actions": [
                "Scrolls to size guide",
                "Tries to interpret measurements",
                "Compares to clothes she owns",
                "Debates between two sizes"
              ],
              "thoughts": "I'm usually a 10 but this brand might run small. The size guide says 10 is 28-inch waist... I think that's me? Maybe I should go for 12 to be safe. But then it might be too loose on top.",
              "emotions": {
                "state": "uncertain",
                "intensity": -1
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Size guide modal"
                }
              ],
              "barriers": [
                {
                  "type": "knowledge",
                  "description": "Size guide shows measurements but no guidance on fit style (relaxed vs fitted)",
                  "severity": 4,
                  "workarounds": "Tries to gauge from model photos"
                },
                {
                  "type": "communications",
                  "description": "No information about model's size for reference",
                  "severity": 3,
                  "workarounds": "Guesses based on how item looks on model"
                }
              ],
              "opportunities": [
                "Add 'model is wearing size X and is Y height' information",
                "Include fit predictor based on previous purchases",
                "Show customer photos with size information"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, 12:37pm"
            }
          },
          {
            "id": "check-reviews",
            "name": "Read customer reviews",
            "duration_ms": 180000,
            "lane_content": {
              "actions": [
                "Scrolls to reviews section",
                "Filters to show reviews with photos",
                "Reads several detailed reviews",
                "Specifically looks for sizing comments"
              ],
              "thoughts": "4.2 stars from 89 reviews, that's decent. Let me see what people say about the fit... 'runs slightly large', 'true to size', 'I sized down'... well that's not helpful, everyone says something different.",
              "emotions": {
                "state": "conflicted",
                "intensity": 0
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Customer reviews section"
                }
              ],
              "barriers": [
                {
                  "type": "knowledge",
                  "description": "Contradictory sizing feedback in reviews",
                  "severity": 3,
                  "workarounds": "Tries to find reviewers with similar body type"
                },
                {
                  "type": "knowledge",
                  "description": "Cannot verify if reviews are genuine",
                  "severity": 2,
                  "workarounds": "Focuses on detailed reviews with photos"
                }
              ],
              "opportunities": [
                "Aggregate sizing feedback into a simple 'runs small/true/large' indicator",
                "Allow filtering reviews by reviewer body type or size",
                "Highlight verified purchase reviews"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, 12:40pm"
            }
          },
          {
            "id": "check-returns",
            "name": "Check return policy",
            "duration_ms": 45000,
            "lane_content": {
              "actions": [
                "Looks for return policy information",
                "Finds and taps 'Returns' link",
                "Reads return conditions",
                "Notes the return window"
              ],
              "thoughts": "Free returns within 30 days, that's reassuring. As long as I keep the tags on I can send it back if it doesn't fit. That makes this less risky.",
              "emotions": {
                "state": "reassured",
                "intensity": 1
              },
              "channels": [
                {
                  "channel": "app",
                  "medium": "digital",
                  "serviceModel": "self_service",
                  "name": "StyleMart App",
                  "usage_context": "Return policy page"
                }
              ],
              "barriers": [
                {
                  "type": "communications",
                  "description": "Return policy requires navigating away from product page",
                  "severity": 2,
                  "workarounds": "Uses back button to return to product"
                }
              ],
              "opportunities": [
                "Show return policy summary directly on product page",
                "Badge products with 'Free Returns' prominently"
              ],
              "device": "iPhone",
              "time_of_day": "Lunch break, 12:43pm"
            }
          }
        ]
      },
