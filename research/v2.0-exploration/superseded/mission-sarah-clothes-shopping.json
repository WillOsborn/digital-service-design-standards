{
  "$context": "https://schemas.digitalservice.design/v2.0",
  "$type": "Mission",
  "id": "mission-sarah-clothes-shopping",
  "version": "2.0.0",
  "title": "Online Clothes Shopping — Personal Treat Purchase",
  "goal": "Find, purchase, and keep a clothing item that feels like a worthwhile personal treat, within budget, with minimal time investment",
  "summary": "Sarah receives a promotional notification about a flash sale, browses for a personal treat, purchases a dress, but returns it due to fit issues. The mission captures the full experience including a branching path where the item could have fit well (keep path) versus the observed return path. It also demonstrates how a simple linear journey maps into the graph model.",

  "scope": {
    "trigger": "Promotional push notification from shopping app",
    "completion": "Item kept and worn, OR refund received after return",
    "timeframe": "7-10 days from notification to resolution",
    "asIs": true,
    "successCriteria": [
      { "metric": "Time to complete purchase", "target": "Under 5 minutes from opening app" },
      { "metric": "Return process completion time", "target": "Under 10 minutes to initiate" },
      { "metric": "Refund processing time", "target": "Within 5 business days" }
    ]
  },

  "actors": [
    {
      "actorRef": "actor-sarah-martinez",
      "contextRef": "ctx-working-mom-consumer",
      "role": "primary"
    }
  ],

  "lanes": {
