      { "id": "channels", "label": "Channels", "type": "channel" },
      { "id": "barriers", "label": "Barriers", "type": "barrier" },
      { "id": "opportunities", "label": "Opportunities", "type": "list" },
      { "id": "accessibility", "label": "Accessibility", "type": "accessibility" }
