{
  "$schema": "https://schemas.digitalservice.design/dsds-config/v1",
  "_comment": "DSDS Organisation Configuration — Full example with common custom fields",

  "org_name": "Example Organisation",
  "schema_versions": ["2.0", "1.1"],
  "base_schema_version": "2.0.0",
  "artifacts_path": "./artifacts",

  "v2.0_paths": {
    "actors": "actors/",
    "missions": "missions/",
    "experiences": "experiences/"
  },

  "v1.1_paths": {
    "personas": "personas/",
    "roles": "roles/",
    "pairings": "pairings/",
    "journeys": "journeys/"
  },

  "custom_fields": {
    "actor": {
      "required": ["customer_segment"],
      "optional": ["department", "crm_id"]
    },
    "mission": {
      "required": ["product_area"],
      "optional": ["squad_owner"]
    },
    "experience": {
      "required": ["product_area"],
      "optional": ["squad_owner", "last_validated"]
    },
    "persona": {
      "required": ["customer_segment"],
      "optional": ["department", "crm_id", "cost_centre"]
    },
    "role": {
      "required": ["department"],
      "optional": ["product_area"]
    },
    "pairing": {
      "required": [],
      "optional": ["use_case"]
    },
    "journey": {
      "required": ["product_area"],
      "optional": ["squad_owner", "last_validated"]
    }
  },

  "custom_field_definitions": {
    "customer_segment": {
      "type": "enum",
      "values": ["Premium", "Standard", "Basic", "Enterprise"],
      "description": "Customer tier for segmentation and service differentiation"
    },
    "department": {
      "type": "string",
      "description": "Owning department or team"
    },
    "crm_id": {
      "type": "string",
      "pattern": "^CRM-[0-9]+$",
      "description": "Link to CRM record for this actor/persona"
    },
    "cost_centre": {
      "type": "string",
      "description": "Cost centre for budget allocation"
    },
    "product_area": {
      "type": "enum",
      "values": ["Onboarding", "Core Product", "Payments", "Support", "Account Management"],
      "description": "Which product area this relates to"
    },
    "squad_owner": {
      "type": "string",
      "description": "Squad or team responsible for this artifact"
    },
    "last_validated": {
      "type": "date",
      "description": "When this artifact was last validated against reality"
    },
    "use_case": {
      "type": "string",
      "description": "Primary use case this pairing represents"
    }
  },

  "validation": {
    "strict_mode": false,
    "require_research_sources": false,
    "minimum_completeness_score": 60
  },

  "workflow": {
    "require_approval": true,
    "approval_states": ["draft", "approved"]
  },

  "categories": {
    "actors": ["consumer", "employee", "business", "partner"],
    "missions": ["onboarding", "purchase", "service", "support", "offboarding"],
    "personas": ["consumer", "employee", "business", "partner"],
    "roles": ["consumer", "employee", "business"],
    "journeys": ["onboarding", "purchase", "service", "support", "offboarding"]
  }
}
